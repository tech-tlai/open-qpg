<odoo>
    <record id="q_paper_line_view_id" model="ir.actions.report">
        <field name="name">Question Paper View</field>
        <field name="model">question.paper.line</field>
        <field name="report_type">qweb-html</field>  <!-- Changed to HTML -->
        <field name="report_name">education_exam.q_paper_template_view_id</field>
        <field name="report_file">education_exam.q_paper_template_view_id</field>
    </record>

    <template id="q_paper_template_view_id">
<!--        <button class="btn btn-primary"-->
<!--                style="font-size: 16px; padding: 10px 20px; height: 50px; width: 200px;"-->
<!--                onclick="window.print();">-->
<!--            Print Question Paper-->
<!--        </button>-->
        <t t-call="web.html_container">
            <div class="page">
                <h1 style="text-align: center;">Question Paper</h1>
                <hr/>
                <t t-if="docs">
                    <table>
                        <tr>
                            <td>
                                <strong>Exam Name:</strong>
                            </td>
                            <td>
                                <span t-field="docs.qp_id_line_id.exam_name"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Subject Name:</strong>
                            </td>
                            <td>
                                <span t-field="docs.qp_id_line_id.subject_name"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Question paper ID:</strong>
                            </td>
                            <td>
                                <span t-field="docs.qp_id_line_id.paper_id"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Total Time:</strong>
                            </td>
                            <td>
                                <span t-field="docs.qp_id_line_id.version_master_id.cvm_total_time"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Total Questions:</strong>
                            </td>
                            <td>
                                <span t-field="docs.qp_id_line_id.version_master_id.cvm_total_questions"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Standard:</strong>
                            </td>
                            <td>
                                <span t-field="docs.qp_id_line_id.standard_dropdown"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Medium:</strong>
                            </td>
                            <td>
                                <span t-field="docs.qp_id_line_id.medium"/>
                            </td>
                        </tr>
                    </table>
                    <hr/>
                    <t t-set="index" t-value="0"/>
                    <t t-foreach="docs" t-as="o">
                        <t t-set="index" t-value="index + 1"/>
                        <div class="oe_structure"/>
                        <p>
                            <strong><span t-esc="index"/>.
                            </strong>
                            <span t-field="o.question_text"/>
                        </p>
                        <ul>
                            <li>
                                <strong>A.</strong>
                                <span t-field="o.option1"/>
                            </li>
                            <li>
                                <strong>B.</strong>
                                <span t-field="o.option2"/>
                            </li>
                            <li>
                                <strong>C.</strong>
                                <span t-field="o.option3"/>
                            </li>
                            <li>
                                <strong>D.</strong>
                                <span t-field="o.option4"/>
                            </li>
                        </ul>
                    </t>
                </t>
                <t t-else="">
                    <p>No questions available.</p>
                </t>
            </div>
        </t>
    </template>
</odoo>